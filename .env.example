# Your Seavoice Studio deployment's base URL, e.g. https://your-company.seavoice.ai
STUDIO_BASE_URL=

# A web chat channel's id and API secret, from
# Studio -> Developer Settings -> Chat Channels -> Create.
# Server-side only — never reaches the browser.
STUDIO_CHANNEL_ID=
STUDIO_API_SECRET=

# The same channel's webhook secret, shown once alongside the API secret
# when the channel was created with a webhook URL. Needed only so
# app/api/webhook/route.ts can verify follow-up check-ins Studio sends —
# point the channel's webhook URL at {your demo's own base URL}/api/webhook.
STUDIO_WEBHOOK_SECRET=
