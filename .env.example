# Your Seavoice Studio deployment's base URL, e.g. https://your-company.seavoice.ai
STUDIO_BASE_URL=

# A web chat channel's id and API secret, from
# Studio -> Developer Settings -> Chat Channels -> Create.
# Server-side only — never reaches the browser.
STUDIO_CHANNEL_ID=
STUDIO_API_SECRET=

# The same channel's webhook secret, shown once alongside the API secret
# when the channel was created with a webhook URL. Leave blank for the
# simple mode; set it to switch on webhook mode, where
# app/api/messages/route.ts asks for check-ins (follow_up) and
# app/api/webhook/route.ts verifies what Studio sends — point the channel's
# webhook URL at {your demo's own public base URL}/api/webhook.
STUDIO_WEBHOOK_SECRET=
