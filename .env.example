# Your Seavoice Studio deployment's base URL, e.g. https://your-company.seavoice.ai
STUDIO_BASE_URL=

# A Direct API chat channel's id and API secret, from
# Studio -> Developer Settings -> Chat Channels -> Create.
# Server-side only — never reaches the browser.
STUDIO_CHANNEL_ID=
STUDIO_API_SECRET=

# The same channel's callback secret, shown once when the channel first gets
# a Follow-up Callback URL. Leave blank for the simple mode. For callback
# mode, point the channel's Follow-up Callback URL at
# {your demo's own public base URL}/api/callback and set this, so
# app/api/callback/route.ts can verify what Studio sends.
STUDIO_CALLBACK_SECRET=
